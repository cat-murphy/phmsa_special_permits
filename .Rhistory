fra_recs_raw <- read_csv("fra_recs.csv") |>
clean_names() |>
rename(sr_id = srid) |>
rename(recommendation_type = sr_coding_mode) |>
rename(recommendation_category = sr_coding_tier_1) |>
rename(recommendation_subject = sr_coding_tier2) |>
mutate(
abstract = str_to_upper(abstract),
recommendation = str_to_upper(recommendation),
addressee_details = str_to_upper(addressee_details),
city = str_to_upper(city),
state = str_to_upper(state),
overall_status = str_to_upper(overall_status),
recommendation_type = str_to_upper(recommendation_type),
recommendation_category = str_to_upper(recommendation_category),
recommendation_subject = str_to_upper(recommendation_subject),
incident_date=as.Date(as.character(as.POSIXct(event_date))),
date_issued=as.Date(as.character(as.POSIXct(date_issued)))
) |>
mutate(addressee_details = str_remove(addressee_details, ";$")) |>
separate_rows(addressee_details, sep = ";") |>
separate(addressee_details, into = c("addressee", "rec_and_action_response_status", "date_closed"), sep = "\\|") |>
mutate(
addressee = str_trim(addressee, side = c("right")),
rec_and_action_response_status = gsub(" ", "", rec_and_action_response_status),
rec_status = case_when(
str_detect(rec_and_action_response_status, "CLOSED") ~ "CLOSED",
str_detect(rec_and_action_response_status, "OPEN") ~ "OPEN"),
action_response_status = case_when(
str_detect(rec_and_action_response_status, "UNACCEPTABLE") ~ "UNACCEPTABLE",
str_detect(rec_and_action_response_status, "ACCEPTABLEACTION") ~ "ACCEPTABLE",
str_detect(rec_and_action_response_status, "ACCEPTABLEALTERNATE") ~ "ACCEPTABLE ALTERNATE",
str_detect(rec_and_action_response_status, "ACCEPTABLERESPONSE") ~ "ACCEPTABLE",
str_detect(rec_and_action_response_status, "RECONSIDERED") ~ "RECONSIDERED",
str_detect(rec_and_action_response_status, "NOLONGERAPPLICABLE") ~ "NO LONGER APPLICABLE",
str_detect(rec_and_action_response_status, "AWAITRESPONSE") ~ "AWAIT RESPONSE",
str_detect(rec_and_action_response_status, "INITIALRESPONSERECEIVED") ~ "INITIAL RESPONSE RECEIVED",
str_detect(rec_and_action_response_status, "SUPERSEDED") ~ "SUPERSEDED",
str_detect(rec_and_action_response_status, "EXCEEDSRECOMMENDEDACTION") ~ "EXCEEDS RECOMMENDED ACTION"),
date_closed = mdy(date_closed)
) |>
filter(str_detect(addressee, "FRA$")) |>
